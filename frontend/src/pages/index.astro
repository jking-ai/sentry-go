---
import '../styles/global.css';

const apiUrl = import.meta.env.PUBLIC_API_URL ?? '';
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Sentry-Go Command Center</title>

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>

    <style>
        body {
            background-color: #131313;
            color: #e5e2e1;
            -webkit-font-smoothing: antialiased;
            min-height: max(884px, 100dvh);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glow-blue {
            box-shadow: 0 0 12px rgba(173, 198, 255, 0.4);
        }
        .inner-glow-primary {
            box-shadow: inset 0 0 2px rgba(173, 198, 255, 0.6);
        }
        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeSlideIn 0.3s ease-out;
        }
        .remediation-block {
            background: rgba(173, 198, 255, 0.06);
            border: 1px solid rgba(173, 198, 255, 0.15);
        }
        .command-block {
            background: rgba(0, 0, 0, 0.4);
            font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
        }
        .btn-approve {
            background: rgba(52, 211, 153, 0.15);
            border: 1px solid rgba(52, 211, 153, 0.3);
            color: #34d399;
        }
        .btn-approve:hover {
            background: rgba(52, 211, 153, 0.25);
        }
        .btn-reject {
            background: rgba(248, 113, 113, 0.15);
            border: 1px solid rgba(248, 113, 113, 0.3);
            color: #f87171;
        }
        .btn-reject:hover {
            background: rgba(248, 113, 113, 0.25);
        }
        .badge-approved { color: #34d399; background: rgba(52,211,153,0.12); border: 1px solid rgba(52,211,153,0.25); }
        .badge-rejected { color: #f87171; background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.25); }
        .badge-pending  { color: #fbbf24; background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.25); }
    </style>
</head>

<body class="font-body-md overflow-x-hidden">
    <!-- TopAppBar -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-white/10 flex justify-between items-center px-margin h-16 shadow-none">
        <div class="flex items-center gap-3">
            <h1 class="font-display text-h2 font-bold text-primary tracking-tight">Sentry-Go</h1>
        </div>
        <button id="refresh-btn" class="active:scale-95 transition-transform hover:opacity-80 transition-opacity" title="Refresh">
            <span class="material-symbols-outlined text-primary" data-icon="refresh">refresh</span>
        </button>
    </header>

    <main class="pt-24 pb-16 px-margin max-w-6xl mx-auto md:grid md:grid-cols-12 md:gap-xl">
        <!-- Left Column: Info & Controls -->
        <div class="md:col-span-5 space-y-lg mb-lg md:mb-0">
            <!-- Hero Section -->
            <section>
                <div class="glass-card rounded-xl p-md relative overflow-hidden">
                    <div class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-3xl"></div>
                    <h2 class="font-display text-h2 text-on-surface mb-xs">Sentry-Go Command Center</h2>
                    <p class="font-body-md text-on-surface-variant leading-relaxed mb-md">
                        Autonomous Incident Response &amp; Triage Platform. Correlates logs, commits, and metrics to deliver instant root-cause analysis and remediation suggestions.
                    </p>
                    <div class="flex items-center gap-sm">
                        <span class="font-mono-label text-mono-label uppercase tracking-widest text-primary bg-primary/10 px-xs py-1 rounded border border-primary/20">Operational</span>
                        <span class="font-mono-label text-mono-label text-on-surface-variant opacity-60">v1.0.0</span>
                    </div>
                </div>
            </section>

            <!-- Primary Action -->
            <section>
                <button id="simulate" class="w-full bg-primary-container text-on-primary-container py-md px-lg rounded-xl font-h2 flex items-center justify-center gap-sm glow-blue active:scale-[0.98] transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="material-symbols-outlined" data-icon="bolt" data-weight="fill" style="font-variation-settings: 'FILL' 1;">bolt</span>
                    <span id="simulate-text">Trigger Simulation</span>
                </button>
            </section>

            <!-- Visual Data Slice (Desktop) -->
            <div class="glass-card rounded-xl p-md bg-gradient-to-br from-surface-container-high/40 to-surface/40 overflow-hidden relative h-32 hidden md:block">
                <div class="absolute inset-0 flex items-end px-sm pb-sm gap-[2px]">
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 40%"></div>
                    <div class="bg-primary/30 w-full rounded-t-sm" style="height: 65%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 50%"></div>
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 85%"></div>
                    <div class="bg-primary/50 w-full rounded-t-sm" style="height: 30%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 95%"></div>
                    <div class="bg-primary/60 w-full rounded-t-sm" style="height: 70%"></div>
                    <div class="bg-primary/30 w-full rounded-t-sm" style="height: 45%"></div>
                    <div class="bg-secondary/40 w-full rounded-t-sm" style="height: 35%"></div>
                    <div class="bg-secondary/60 w-full rounded-t-sm" style="height: 15%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 55%"></div>
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 80%"></div>
                </div>
                <div class="relative z-10">
                    <span class="font-mono-label text-[10px] uppercase text-on-surface-variant opacity-80">Autonomous Analysis Load</span>
                    <div class="text-h2 font-display text-primary" id="triage-rate">-- <span class="text-sm opacity-60">AVG TRIAGE</span></div>
                </div>
            </div>
        </div>

        <!-- Right Column: Feed -->
        <div class="md:col-span-7 flex flex-col h-full">
            <div class="flex justify-between items-end mb-md">
                <h3 class="font-display text-h2 text-on-surface">Recent Incidents</h3>
                <span class="font-mono-label text-mono-label text-secondary uppercase">Live Feed</span>
            </div>

            <div class="space-y-sm flex-1" id="feed">
                <div class="text-center p-md text-on-surface-variant">Loading incident reports...</div>
            </div>

            <!-- Visual Data Slice (Mobile) -->
            <div class="glass-card rounded-xl p-md mt-lg bg-gradient-to-br from-surface-container-high/40 to-surface/40 overflow-hidden relative h-32 md:hidden">
                <div class="absolute inset-0 flex items-end px-sm pb-sm gap-[2px]">
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 40%"></div>
                    <div class="bg-primary/30 w-full rounded-t-sm" style="height: 65%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 50%"></div>
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 85%"></div>
                    <div class="bg-primary/50 w-full rounded-t-sm" style="height: 30%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 95%"></div>
                    <div class="bg-primary/60 w-full rounded-t-sm" style="height: 70%"></div>
                    <div class="bg-primary/30 w-full rounded-t-sm" style="height: 45%"></div>
                    <div class="bg-secondary/40 w-full rounded-t-sm" style="height: 35%"></div>
                    <div class="bg-secondary/60 w-full rounded-t-sm" style="height: 15%"></div>
                    <div class="bg-primary/40 w-full rounded-t-sm" style="height: 55%"></div>
                    <div class="bg-primary/20 w-full rounded-t-sm" style="height: 80%"></div>
                </div>
                <div class="relative z-10">
                    <span class="font-mono-label text-[10px] uppercase text-on-surface-variant opacity-80">Autonomous Analysis Load</span>
                    <div class="text-h2 font-display text-primary" id="triage-rate-mobile">-- <span class="text-sm opacity-60">AVG TRIAGE</span></div>
                </div>
            </div>
        </div>
    </main>

    <script define:vars={{ apiUrl }}>
        function updateTriageRate(reports) {
            if (!reports || reports.length === 0) return;
            const total = reports.reduce((sum, r) => sum + (r.triage_time || 0), 0);
            const avg = (total / reports.length / 1e9).toFixed(1);
            const label = avg + 's';
            document.getElementById('triage-rate').innerHTML = label + ' <span class="text-sm opacity-60">AVG TRIAGE</span>';
            const mobile = document.getElementById('triage-rate-mobile');
            if (mobile) mobile.innerHTML = label + ' <span class="text-sm opacity-60">AVG TRIAGE</span>';
        }

        async function loadReports() {
            const feed = document.getElementById('feed');
            if (!apiUrl) {
                feed.innerHTML = '<div class="glass-card rounded-xl p-md text-center text-error">PUBLIC_API_URL is not configured. Set it in your .env file before building.</div>';
                return;
            }
            try {
                const response = await fetch(`${apiUrl}/api/v1/incidents`);
                const reports = await response.json();
                updateTriageRate(reports);

                if (!reports || reports.length === 0) {
                    feed.innerHTML = '<div class="glass-card rounded-xl p-md text-center text-on-surface-variant">No incidents found. System is healthy.</div>';
                    return;
                }

                feed.innerHTML = reports.map(report => {
                    const isTriage = report.status.toLowerCase() === 'triage';
                    const time = ((report.triage_time || 0) / 1e9).toFixed(2);
                    const hasRemediation = report.remediation && (report.remediation.suggestion || report.remediation.command);
                    const approvalStatus = (report.approval_status || 'PENDING').toUpperCase();

                    let approvalBadge = '';
                    if (approvalStatus === 'APPROVED') {
                        approvalBadge = '<span class="badge-approved font-mono-label text-[10px] uppercase px-1.5 py-0.5 rounded">Approved</span>';
                    } else if (approvalStatus === 'REJECTED') {
                        approvalBadge = '<span class="badge-rejected font-mono-label text-[10px] uppercase px-1.5 py-0.5 rounded">Rejected</span>';
                    } else {
                        approvalBadge = '<span class="badge-pending font-mono-label text-[10px] uppercase px-1.5 py-0.5 rounded">Pending</span>';
                    }

                    let remediationHTML = '';
                    if (hasRemediation) {
                        const suggestion = report.remediation.suggestion || '';
                        const command = report.remediation.command || '';
                        remediationHTML = `
                            <div class="remediation-block rounded-lg p-sm mt-xs">
                                <div class="flex items-center gap-1 mb-1">
                                    <span class="material-symbols-outlined text-[14px] text-primary">build</span>
                                    <span class="font-mono-label text-[10px] uppercase text-primary tracking-wider">Remediation</span>
                                </div>
                                ${suggestion ? `<p class="text-on-surface-variant text-xs mb-1">${escapeHTML(suggestion)}</p>` : ''}
                                ${command ? `<div class="command-block rounded px-2 py-1 text-xs text-primary/90 break-all"><span class="opacity-50">$ </span>${escapeHTML(command)}</div>` : ''}
                            </div>
                        `;
                    }

                    let approvalActions = '';
                    if (hasRemediation && (approvalStatus === 'PENDING')) {
                        approvalActions = `
                            <div class="flex gap-2 mt-xs">
                                <button class="btn-approve text-xs px-3 py-1 rounded-md active:scale-95 transition-all flex items-center gap-1"
                                        onclick="submitApproval('${report.incident_id}', 'APPROVE')">
                                    <span class="material-symbols-outlined text-[14px]">check_circle</span> Approve
                                </button>
                                <button class="btn-reject text-xs px-3 py-1 rounded-md active:scale-95 transition-all flex items-center gap-1"
                                        onclick="submitApproval('${report.incident_id}', 'REJECT')">
                                    <span class="material-symbols-outlined text-[14px]">cancel</span> Reject
                                </button>
                            </div>
                        `;
                    }

                    return `
                        <div class="glass-card rounded-xl p-md flex flex-col gap-sm border-l-2 ${isTriage ? 'border-l-primary-container animate-pulse-subtle' : 'border-l-secondary'} animate-fade-in">
                            <div class="flex justify-between items-start">
                                <div class="flex flex-col">
                                    <span class="font-mono-label text-mono-label text-on-surface-variant">#${escapeHTML(report.incident_id)}</span>
                                    <h4 class="font-h2 text-on-surface text-lg">Incident ${isTriage ? 'Under Triage' : 'Resolved'}</h4>
                                </div>
                                <div class="flex flex-col items-end gap-1">
                                    <span class="flex items-center gap-1 ${isTriage ? 'text-primary' : 'text-secondary'} font-bold text-xs uppercase tracking-tighter">
                                        <span class="w-1.5 h-1.5 rounded-full ${isTriage ? 'bg-primary animate-ping' : 'bg-secondary'}"></span>
                                        ${escapeHTML(report.status)}
                                    </span>
                                    <span class="text-[10px] text-on-surface-variant/60 font-mono-label mt-1">${time}s TRIAGE</span>
                                    ${approvalBadge}
                                </div>
                            </div>
                            <div class="pt-sm border-t border-white/5">
                                <p class="text-on-surface-variant text-sm font-body-md italic leading-snug">
                                    Root Cause: ${escapeHTML(report.root_cause || 'No analysis provided.')}
                                </p>
                            </div>
                            ${remediationHTML}
                            ${approvalActions}
                        </div>
                    `;
                }).join('');
            } catch (e) {
                feed.innerHTML = '<div class="glass-card rounded-xl p-md text-center text-error">Failed to load reports. Ensure the Sentry-Go backend is running.</div>';
            }
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str || '';
            return div.innerHTML;
        }

        async function submitApproval(incidentId, action) {
            if (!apiUrl) return;
            try {
                const resp = await fetch(`${apiUrl}/api/v1/incidents/${incidentId}/actions`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, comment: action === 'APPROVE' ? 'Approved via dashboard' : 'Rejected via dashboard' })
                });
                if (resp.ok) {
                    loadReports();
                } else {
                    const err = await resp.json();
                    alert('Action failed: ' + (err.error || resp.statusText));
                }
            } catch (e) {
                alert('Failed to submit action.');
            }
        }

        document.getElementById('simulate')?.addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            const textSpan = document.getElementById('simulate-text');
            btn.disabled = true;
            textSpan.innerText = 'Triggering...';

            const id = 'sim-' + Math.random().toString(36).substr(2, 5);
            try {
                await fetch(`${apiUrl}/api/v1/alerts`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: {
                            data: btoa(JSON.stringify({
                                incident: {
                                    incident_id: id,
                                    policy_name: "Portfolio Simulation",
                                    condition_name: "Manual Click",
                                    resource_id: "example-service"
                                }
                            }))
                        }
                    })
                });
                textSpan.innerText = 'Triage in Progress... (Wait 15s)';
                setTimeout(() => {
                    loadReports();
                    btn.disabled = false;
                    textSpan.innerText = 'Trigger Simulation';
                }, 15000);
            } catch (err) {
                alert('Failed to trigger simulation.');
                btn.disabled = false;
                textSpan.innerText = 'Trigger Simulation';
            }
        });

        document.getElementById('refresh-btn')?.addEventListener('click', () => loadReports());

        // Initial load + auto-refresh every 30s
        loadReports();
        setInterval(loadReports, 30000);
    </script>
</body>
</html>